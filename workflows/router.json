            {
              "id": "cond-regex-admin",
              "leftValue": "={{ $json.message?.text ?? '' }}",
              "rightValue": "^\\/(soyadmin|hoy|agenda)\\b",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-a-admin",
      "name": "Ir a Agenda Admin",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
